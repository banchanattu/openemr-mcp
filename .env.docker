# Docker-specific runtime configuration for openemr-mcp.
# This file is loaded by ./startdocker.sh.
#
# Important:
# - From inside the container, use host.docker.internal to reach services on your host.
# - OPENEMR_API_BASE_URL must include /apis/default for this codebase.

OPENEMR_DATA_SOURCE=api
OPENEMR_API_BASE_URL=http://host.docker.internal:8300/apis/default
OPENEMR_OAUTH_SITE=default
OPENEMR_API_VERIFY_SSL=false

# Optional: uncomment and fill these if you want startdocker.sh to provide
# OpenEMR OAuth credentials directly instead of inheriting them from your shell.
# OPENEMR_OAUTH_CLIENT_ID=
# OPENEMR_OAUTH_CLIENT_SECRET=
# OPENEMR_OAUTH_USERNAME=
# OPENEMR_OAUTH_PASSWORD=
