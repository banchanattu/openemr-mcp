# OpenEMR MCP Server — Environment Variables
# Copy this file to .env and fill in your values.
# All variables are optional unless noted.

# ---------------------------------------------------------------------------
# MCP Transport
# ---------------------------------------------------------------------------
# Controls how the MCP server is exposed.
#   stdio            (default) — launched by an MCP client as a subprocess
#   streamable-http            — standalone HTTP server, recommended for network use
OPENEMR_MCP_TRANSPORT=stdio
OPENEMR_MCP_HOST=127.0.0.1
OPENEMR_MCP_PORT=8305
OPENEMR_MCP_PATH=/mcp

# Public base URL used in ARD/.well-known discovery metadata.
# Set this in real deployments so discovery publishes externally reachable HTTPS URLs.
OPENEMR_MCP_PUBLIC_BASE_URL=https://mcp.your-openemr.example.com

# Optional discovery metadata overrides.
OPENEMR_MCP_SERVER_NAME=openemr-mcp-server
OPENEMR_MCP_SERVER_TITLE="OpenEMR Healthcare MCP Server"
OPENEMR_MCP_SERVER_DESCRIPTION="Provides secure Model Context Protocol access to OpenEMR EHR data, FHIR/REST primitives, patient lookup, and appointment scheduling."
OPENEMR_MCP_SERVER_ICON_URL=
OPENEMR_MCP_VENDOR_NAME="OpenEMR Community / Internal Tech Team"
OPENEMR_MCP_VENDOR_URL=
OPENEMR_MCP_AUTHORIZATION_SERVER=
OPENEMR_MCP_AUTH_SCOPES=openid,fhirUser,patient/*.read

# Leave false unless SSE transport is implemented and intentionally advertised.
OPENEMR_MCP_ENABLE_SSE_CARD_ENTRY=false

# ---------------------------------------------------------------------------
# Data Source
# ---------------------------------------------------------------------------
# Controls where patient/clinical data comes from.
#   mock  (default) — built-in curated demo data, no network required
#   db              — direct MySQL connection to OpenEMR database
#   api             — OpenEMR FHIR R4 REST API (recommended for production)
OPENEMR_DATA_SOURCE=mock

# ---------------------------------------------------------------------------
# Database Mode (OPENEMR_DATA_SOURCE=db)
# ---------------------------------------------------------------------------
OPENEMR_DB_HOST=localhost
OPENEMR_DB_PORT=3306
OPENEMR_DB_USER=openemr
OPENEMR_DB_PASSWORD=openemr
OPENEMR_DB_NAME=openemr

# ---------------------------------------------------------------------------
# API / FHIR Mode (OPENEMR_DATA_SOURCE=api)
# ---------------------------------------------------------------------------
# Base URL of your OpenEMR installation's API endpoint (includes /apis/default)
# Local process example: http://localhost:8300/apis/default
# Docker container talking to OpenEMR on the host: http://host.docker.internal:8300/apis/default
OPENEMR_API_BASE_URL=https://your-openemr.example.com/apis/default

# OAuth2 site path — matches the site name in OpenEMR (usually "default")
OPENEMR_OAUTH_SITE=default

# Temporary debug flag. When true, logs the full outbound bearer token sent to OpenEMR.
# Leave false in normal use.
OPENEMR_LOG_OUTBOUND_BEARER_TOKEN=false

# OAuth2 credentials for OpenEMR's built-in OAuth2 server
OPENEMR_OAUTH_CLIENT_ID=your_client_id
OPENEMR_OAUTH_CLIENT_SECRET=your_client_secret
OPENEMR_OAUTH_USERNAME=admin
OPENEMR_OAUTH_PASSWORD=your_password

# ---------------------------------------------------------------------------
# Drug Interactions
# ---------------------------------------------------------------------------
# Controls the drug interaction checker.
#   mock    (default) — 10 built-in drug pairs, always works, no network
#   openfda           — OpenFDA FAERS co-reporting (free, no key, heuristic severity)
#   rxnorm            — (DEPRECATED/UNAVAILABLE) RxNorm interaction API endpoints retired
DRUG_INTERACTION_SOURCE=mock

# ---------------------------------------------------------------------------
# Symptom Checker
# ---------------------------------------------------------------------------
# Controls symptom lookup data source.
#   mock        (default) — curated local dataset, instant, no network
#   infermedica             — Infermedica Symptom Checker API
#                            Free tier: 100 calls/day
#                            Register at: https://developer.infermedica.com/
SYMPTOM_SOURCE=mock

# Infermedica API credentials (required when SYMPTOM_SOURCE=infermedica)
INFERMEDICA_APP_ID=
INFERMEDICA_APP_KEY=

# ---------------------------------------------------------------------------
# OpenFDA
# ---------------------------------------------------------------------------
# Controls FDA adverse events and drug label lookups.
#   mock  (default) — built-in FDA mock data for 6 common drugs
#   live            — live OpenFDA API (free, higher rate limits with key)
OPENFDA_SOURCE=mock

# OpenFDA API key (optional; increases rate limits from 40 to 240 req/min)
# Register at: https://open.fda.gov/apis/authentication/
OPENFDA_API_KEY=
